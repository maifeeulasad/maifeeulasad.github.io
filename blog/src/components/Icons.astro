---
// Loads only the Material Symbols the blog actually uses — keeps the font payload tiny.
// To add a new icon, append its name here or pass it dynamically from site.ts / posts.
const names = [
  'arrow_back','arrow_forward','arrow_outward','arrow_right','article','check',
  'chevron_left','chevron_right','code','code_blocks','content_copy','dark_mode',
  'deployed_code','explore','feed','format_list_bulleted','grid_view','home',
  'ios_share','keyboard_double_arrow_left','keyboard_double_arrow_right',
  'library_books','light_mode','link','mail','menu','menu_book','open_in_new',
  'person','rss_feed','schedule','search','share','star','sticky_note_2',
  'terminal','work',
];
const url = `https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..500,0,0&icon_names=${names.join(',')}&display=block`;
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
  rel="stylesheet"
/>
<link href={url} rel="stylesheet" />
